# Copy to .env and replace every placeholder. Never commit .env.
#
# Demo mode (npm run demo) needs none of this: it simulates deployments in the
# dashboard process and never touches Docker, Postgres or Redis.
DEMO_MODE=false

# --- Dashboard sign-in (single owner) ---------------------------------------
OWNER_EMAIL=owner@launchpad.local
# At least 12 characters.
OWNER_PASSWORD=change-this-owner-password
# openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# Public URL of the dashboard. Cookies are marked Secure when this is https.
APP_URL=http://localhost:3000

# --- Secrets at rest ---------------------------------------------------------
# 32-byte key, hex. Encrypts stored environment variable values.
# Generate your own with: openssl rand -hex 32
ENV_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Data stores -------------------------------------------------------------
# Used when running the dashboard on the host (npm run dev). Docker Compose
# overrides both with its internal service addresses.
DATABASE_URL=postgresql://launchpad:launchpad@localhost:5432/launchpad
REDIS_URL=redis://localhost:6379

# --- What may be deployed ----------------------------------------------------
# Exact GitHub owners (users or organisations) you control, comma separated.
GITHUB_ALLOWED_OWNERS=your-github-username

# --- Application routing -----------------------------------------------------
# Projects are served at <name>.<APP_DOMAIN>. "localhost" needs no DNS:
# browsers resolve *.localhost to this machine.
APP_DOMAIN=localhost
APP_SCHEME=http
# Port Caddy is published on. Leave empty for 80/443 in production.
APP_PUBLIC_PORT=8080

# --- Worker limits (optional; defaults shown) --------------------------------
# BUILD_TIMEOUT_MS=600000
# CLONE_TIMEOUT_MS=120000
# HEALTH_TIMEOUT_MS=60000
# RETAINED_RELEASES=3
# BUILD_LOG_MAX_LINES=5000
# APP_MEMORY_MB=512
# APP_CPUS=1
# APP_PIDS_LIMIT=256
# APP_LOG_MAX_SIZE=10m
# APP_LOG_MAX_FILES=3
# WORKER_CONCURRENCY=2
